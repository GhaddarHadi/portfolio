# Copy this file to `.env.local` and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API

# Safe to expose to the browser (protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY — never import this into a client component. Bypasses RLS.
# Used by the seed script and (later) the heartbeat cron.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Which login email owns the content (used by the seed script to find your user).
SEED_OWNER_EMAIL=hadimghaddar@gmail.com

# Public base URL of the deployed site (used for OG images / JSON-LD later).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
